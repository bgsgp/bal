<Window x:Class="BlueArchiveLottery.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="曜麟·天衡" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题图片 -->
        <Image Grid.Row="0" Source="resources/img/title.png"
               Stretch="Uniform" Height="120" Margin="0,0,0,10"
               RenderOptions.BitmapScalingMode="Fant"/>
        <TextBlock Grid.Row="0" Text="奖励/惩罚抽选器"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                   FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"
                   Margin="0,0,0,10"
                   Visibility="Collapsed" x:Name="TitleFallbackText"/>

        <!-- 模式标签 -->
        <Border Grid.Row="1"
                Background="{DynamicResource WhiteBrush}"
                CornerRadius="8" Padding="10,5"
                HorizontalAlignment="Center" Margin="0,5">
            <TextBlock x:Name="ModeLabel" Text="当前模式：普通模式"
                       FontSize="16" Foreground="{DynamicResource TextBrush}"/>
        </Border>

        <!-- 抽选结果显示区域 -->
        <Border Grid.Row="2" Background="{DynamicResource WhiteBrush}"
                BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="2"
                CornerRadius="15" Padding="20" Margin="10,10">
            <TextBlock x:Name="ResultDisplay" Text="点击开始抽选"
                       FontSize="24" FontWeight="Bold"
                       FontFamily="Segoe UI Emoji, Microsoft YaHei"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextBrush}"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- 按钮区域 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
            <Button x:Name="BtnStart" Content="开始抽选" Click="BtnStart_Click"
                    Style="{DynamicResource PrimaryButton}"/>
            <Button x:Name="BtnSettings" Content="设置" Click="BtnSettings_Click"
                    Style="{DynamicResource AccentButton}"/>
        </StackPanel>
    </Grid>
</Window>