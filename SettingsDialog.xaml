<Window x:Class="BlueArchiveLottery.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="抽选器设置" Height="450" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <GroupBox Header="配置文件管理" Grid.Row="0"
                  Foreground="{DynamicResource TextBrush}">
            <StackPanel>
                <Button Click="EditConfig_Click" Content="📝 编辑json配置文件"
                        Style="{DynamicResource PrimaryButton}"/>
                <TextBlock x:Name="ConfigPathLabel" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextBrush}" Margin="0,5"/>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="抽选模式设置" Grid.Row="1" Margin="0,10,0,0"
                  Foreground="{DynamicResource TextBrush}">
            <CheckBox x:Name="FullModeCheckBox" Content="完全模式"
                      Foreground="{DynamicResource TextBrush}" Margin="0,5"/>
        </GroupBox>
        <TextBlock Grid.Row="2" TextWrapping="Wrap" Margin="0,10"
                   Foreground="{DynamicResource TextBrush}">
            配置文件格式说明：<LineBreak/>
            {<LineBreak/>
              "levels": [<LineBreak/>
                {<LineBreak/>
                  "star": 1,<LineBreak/>
                  "probability": 78.5,<LineBreak/>
                  "items": ["奖项1", "奖项2"]<LineBreak/>
                }<LineBreak/>
              ]<LineBreak/>
            }<LineBreak/>
            注意：所有级别概率总和建议为100%！
        </TextBlock>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="3">
            <Button Content="确定" Click="Ok_Click"
                    Style="{DynamicResource PrimaryButton}"/>
            <Button Content="取消" Click="Cancel_Click"
                    Style="{DynamicResource SecondaryButton}"/>
        </StackPanel>
    </Grid>
</Window>